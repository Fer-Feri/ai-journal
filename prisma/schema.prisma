generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  content   String
  mood      String
  aiScore   Float    @default(0)
  aiSummary String   @default("")
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}
